# ---- 광고 (웹: AdSense) ----
# 비워두면 광고 자리에 '광고 영역' 플레이스홀더만 표시됩니다.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_LIST=

# ---- 카카오톡 공유 (developers.kakao.com 앱의 JavaScript 키, 도메인 등록 필요) ----
VITE_KAKAO_JS_KEY=

# ---- AI 코칭 (서버 함수 api/coach.js 에서만 사용, 브라우저로 노출되지 않음) ----
ANTHROPIC_API_KEY=

# ---- Vercel 배포 (계정·클라우드 저장·푸시) ----
# 세션 서명 비밀키 (아무 긴 문자열, 예: openssl rand -hex 32)
AUTH_SECRET=
# Upstash Redis (Vercel Marketplace → Upstash for Redis 연결 시 자동 주입됨)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 웹 푸시 VAPID 키 (node scripts/gen-vapid.mjs 로 생성)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 크론 보호 (Vercel 이 Authorization 헤더로 보냄)
CRON_SECRET=
# 베타: 모든 가입자에게 프리미어 기능 개방 (0 이면 플랜대로 제한)
BETA_ALL_ACCESS=1
