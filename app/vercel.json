{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/|tips/|assets/|sw.js|workbox-.*|manifest.webmanifest|icon.svg|ads.txt|registerSW.js).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/morning", "schedule": "30 22 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 23 * * 0" }
  ]
}
